PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_scanner?sslmode=disable
LOG_LEVEL=info
APP_ENV=development
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_ROUTINE_MODEL=anthropic/claude-haiku-5.5
LLM_STRONG_MODEL=anthropic/claude-sonnet-5.5
LLM_TIMEOUT=2m
FETCH_USER_AGENT=CivicScanner/1.0 (+https://github.com/andrewcgraves/civic-scanner)
FETCH_TIMEOUT=30s
FETCH_MAX_BYTES=134217728
FETCH_MAX_REDIRECTS=5
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT=90s
FEATURE_FLAGS=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_FLAG_TIMEOUT=1s
