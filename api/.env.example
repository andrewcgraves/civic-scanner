FIRECRAWL_TIMEOUT=90s
FEATURE_FLAGS=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_FLAG_TIMEOUT=1s
POSTHOG_FLAG_CACHE_TTL=30s
TRANSCRIPTION_PROVIDER=gateway
