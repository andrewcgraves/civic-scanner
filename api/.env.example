PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_scanner?sslmode=disable
LOG_LEVEL=info
APP_ENV=development
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_ROUTINE_MODEL=anthropic/claude-haiku-5.5
LLM_STRONG_MODEL=anthropic/claude-sonnet-5.5
LLM_TIMEOUT=2m
FEATURE_FLAGS=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_FLAG_TIMEOUT=1s
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT=5m
TRANSCRIPTION_MAX_UPLOAD_MB=25
