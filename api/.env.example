GROQ_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MAX_UPLOAD_MB=25
INGEST_CHECK_HOUR_UTC=13
EXTRACT_PDF_BINARY=
EXTRACT_PDF_TIMEOUT=60s
EXTRACT_PDF_MAX_MEMORY=536870912
EXTRACT_MAX_TEXT_BYTES=8388608
AUDIO_LIMIT_BINARY=
